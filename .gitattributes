# 默认按文本处理并统一换行，避免 macOS/Linux 检出差异
* text=auto eol=lf

# Swift / Shell / YAML / JSON 一律 LF
*.swift      text eol=lf
*.sh         text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.json       text eol=lf
*.md         text eol=lf
VERSION      text eol=lf
.gitignore   text eol=lf
.gitattributes text eol=lf
.editorconfig  text eol=lf

# 脚本必须是可执行文件
build_app.sh  text eol=lf
build_dmg.sh  text eol=lf
run_tests.sh  text eol=lf
doctor.sh     text eol=lf

# 二进制资源：不参与 diff / 换行转换
*.png        binary
*.jpg        binary
*.jpeg       binary
*.icns       binary
*.dmg        binary
*.a          binary
*.dylib      binary

# 不要在 GitHub 语言统计里把文档算进去
Docs/*.png   linguist-documentation
*.md         linguist-documentation
