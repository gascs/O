root = true

# 默认：UTF-8、LF、行尾去掉空白、文件末尾保留一个换行
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Swift：4 空格；换行宽度 120（与现有代码风格一致）
[*.swift]
indent_size = 4
max_line_length = 120

# Shell 脚本必须 2 空格 + LF，否则 set -euo pipefail 之类的缩进会漂移
[*.sh]
indent_size = 2

# 文档与配置：2 空格
[*.{md,yml,yaml,json}]
indent_size = 2
trim_trailing_whitespace = false

# Markdown 中行尾两个空格是有意义的硬换行，不裁剪
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{png,jpg,jpeg,icns,dmg}]
insert_final_newline = false
